{
  "name": "catfish",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "share": "npx expo start --tunnel",
    "simulator:web": "npx expo start --web",
    "simulator:ios": "npx expo start --ios",
    "simulator:android": "npx expo start --android",
    "build:simulator:ios": "eas build --profile simulator --platform ios",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:all": "eas build --profile preview --platform all",
    "build:web": "npx expo export:web",
    "run:ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx expo run:ios",
    "build:development:ios": "eas build --profile development --platform ios",
    "generate:icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "^7.9.0",
    "expo": "~54.0.30",
    "expo-application": "^7.0.8",
    "expo-constants": "^18.0.13",
    "expo-dev-client": "^6.0.20",
    "expo-device": "^8.0.10",
    "expo-file-system": "^19.0.19",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-media-library": "^18.2.1",
    "expo-navigation-bar": "^5.0.10",
    "expo-print": "^15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^13.1.5",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "expo-updates": "~29.0.15",
    "posthog-react-native": "^3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fbsdk-next": "^13.4.1",
    "react-native-purchases": "^9.6.8",
    "react-native-purchases-ui": "^9.6.9",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "tslib": "^2.8.1"
  },
  "private": true,
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
